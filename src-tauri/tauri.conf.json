{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Botanical Network",
  "version": "0.1.0",
  "identifier": "com.botanicalnetwork.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Botanical Network",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#F4F1EA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Delhi Metro map with your saved places",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
